generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  name            String           @unique
  profileImage    String?
  totalDemerits   Int              @default(0)
  goals           WeeklyGoal[]
  posts           Post[]
  comments        Comment[]        // 댓글 관계 추가
  penaltyHistory  PenaltyHistory[]
  createdAt       DateTime         @default(now())
}

model WeeklyGoal {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  year           Int
  week           Int
  workoutTarget  Int      @default(3)
  dietTarget     Int      @default(5)
  @@unique([userId, year, week])
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  imageUrl  String
  content   String?
  category  String   
  likes     Int      @default(0)
  fire      Int      @default(0) // 불꽃 리액션 추가
  strong    Int      @default(0) // 근육 리액션 추가
  comments  Comment[]           // 댓글 관계 추가
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model PenaltyHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  year      Int
  week      Int
  points    Int
  reason    String
  createdAt DateTime @default(now())
}
